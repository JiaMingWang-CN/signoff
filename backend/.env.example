# 复制为 backend/.env 后填写。.env 已在 .gitignore 中，切勿提交。

# ── 应用 ────────────────────────────────────────────────
# 用于加密数据库中的 GitHub token 与签名会话 cookie，至少 32 字节随机串。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# 浏览器访问的前端地址；OAuth 回调为 {PUBLIC_URL}/api/auth/github/callback
PUBLIC_URL=http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── 数据库（二选一）────────────────────────────────────
DATABASE_URL=sqlite:///./data/workbench.db
# DATABASE_URL=postgresql+psycopg://workbench:password@127.0.0.1:5432/workbench

# ── GitHub OAuth App ───────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo read:user
# 允许登录的 GitHub 用户名（逗号分隔）。留空表示任何 GitHub 账号都能登录并看到全部已导入仓库；对外暴露时务必填写。
ALLOWED_GITHUB_USERS=

# ── 免登录示例仓库 ─────────────────────────────────────
DEMO_REPO=JiaMingWang-CN/oss-workbench-demo
# 访客模式服务端读取演示仓库用的 token（建议只读 fine-grained PAT）。留空则回退为匿名访问（限流 60 次/小时）。
DEMO_GITHUB_TOKEN=
# 访客每 IP 每日限额
GUEST_DAILY_AGENT_RUNS=5
GUEST_DAILY_LLM_TOKENS=200000

# ── LLM（OpenAI 兼容接口）──────────────────────────────
# Base URL、模型和 API Key 在网页“设置”页配置（API Key 加密后存入数据库），这里不再读取。
LLM_TIMEOUT_SECONDS=120

# ── Agent ──────────────────────────────────────────────
# 默认工作区根目录（每个仓库一个 clone，每次运行一个 git worktree），界面中可改
WORKSPACE_DIR=~/.oss-workbench/workspaces
# 默认权限预设：readonly | approve | auto | full
AGENT_DEFAULT_PERMISSION=approve
AGENT_MAX_STEPS=40
AGENT_COMMAND_TIMEOUT_SECONDS=300

# ── 代码检索 / 漏洞扫描 ────────────────────────────────
# 本机安装的 codegraph CLI（npm i -g @colbymchenry/codegraph，已验证 1.6.0）；不在 PATH 时填完整路径
CODEGRAPH_BIN=codegraph
OSV_API_URL=https://api.osv.dev/v1
# 可选静态扫描器，未安装时自动跳过，仅使用内置规则
SEMGREP_BIN=semgrep
BANDIT_BIN=bandit
